%h2= work_experience_name_label

%p Every #{EffectiveWorkExperience.summary_months} months, #{work_experience_interns_label.downcase} are required to submit a #{work_experience_summary_label.downcase} for your review.

%hr

%h4= work_experience_mentor_label

- if current_user.work_experience_mentees.present?
  %p You are #{work_experience_mentor_label.downcase} to the following #{work_experience_interns_label.downcase}: #{current_user.work_experience_mentees.map(&:to_s).sort.to_sentence}.
- else
  %p You have no assigned mentees.

- if current_user.work_experience_supervisor?
  %h4= work_experience_supervisor_label
  - if current_user.work_experience_supervisees.present?
    %p You are #{work_experience_supervisor_label.downcase} to the following #{work_experience_interns_label.downcase}: #{current_user.work_experience_supervisees.map(&:to_s).sort.to_sentence}.
  - else
    %p You have no currently assigned supervisees.

%hr

%h4 #{EffectiveWorkExperience.summary_months}-Month #{work_experience_summary_label} Submissions
%p Please review the following #{etsd(EffectiveWorkExperience.WorkExperienceSummary)}:

- datatable = EffectiveWorkExperienceSummariesReviewDatatable.new(self)
= render_datatable(datatable)

%hr

%h4= work_experience_reports_label
%p View your #{work_experience_intern_label.downcase}'s entire #{work_experience_name_label.downcase} hours.

- datatable = EffectiveWorkExperienceReportsReviewDatatable.new(self)
= render_simple_datatable(datatable)
