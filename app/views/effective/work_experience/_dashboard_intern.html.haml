%h2= work_experience_name_label

%p Please use the following tables to track your #{work_experience_name_label.downcase}.

%p
  You can view your entire
  = link_to(work_experience_report_label.downcase, effective_work_experience.work_experience_report_path(current_user))
  at any time.

- if EffectiveWorkExperience.hours_log?
  %p Add a record for each activity, then submit a #{work_experience_summary_label.downcase} for each quarter.
- else
  %p #{work_experience_interns_label} are required to submit a #{work_experience_record_label.downcase} for each month of their internship. Every #{EffectiveWorkExperience.summary_months} months they are required to submit a #{work_experience_summary_label.downcase}.

%hr

%h4= work_experience_mentor_label

- if current_user.work_experience_mentor.present?
  %p Your #{work_experience_mentor_label.downcase} is #{link_to(current_user.work_experience_mentor, "mailto:#{current_user.work_experience_mentor.email}")}.
- elsif current_user.work_experience_outside_mentor?
  - outside_mentor = current_user.work_experience_outside_mentor
  %p Your #{etd(Effective::WorkExperienceOutsideMentor)} is #{link_to(outside_mentor.name, "mailto:#{outside_mentor.email}")}.
- else
  %p No #{work_experience_mentor_label.downcase} has been assigned. Please contact us to be assigned one.

- if current_user.work_experience_supervisor.present?
  %h4= work_experience_supervisor_label
  %p Your #{work_experience_supervisor_label.downcase} is #{mail_to(current_user.work_experience_supervisor.email, current_user.work_experience_supervisor.to_s)}.

%hr

- if EffectiveResources.authorized?(self, :index, Effective::WorkExperienceRecord)
  - if EffectiveWorkExperience.hours_log?
    %h4= work_experience_records_label
    %p Add one record for each activity, including the date and hours worked.
  - else
    %h4 Monthly #{work_experience_records_label}
    %p Please use the following table to track your monthly #{etsd(Effective::WorkExperienceRecord)}.

  .mb-2
    = collapse("Show #{ets(Effective::WorkExperienceRecord)}") do
      - datatable = EffectiveWorkExperienceRecordsDatatable.new(self, user: current_user, namespace: :effective)
      = render_datatable(datatable)

  %p= link_to "Add a new #{etd(Effective::WorkExperienceRecord)}", effective_work_experience.new_work_experience_record_path, class: 'btn btn-primary'

  %hr

- if EffectiveWorkExperience.monthly_grid? && EffectiveResources.authorized?(self, :index, Effective::WorkExperienceProject)
  %h4= work_experience_projects_label
  %p Please use the following table to track your #{etsd(Effective::WorkExperienceProject)}.

  .mb-2
    = collapse("Show #{ets(Effective::WorkExperienceProject)}") do
      - datatable = EffectiveWorkExperienceProjectsDatatable.new(self, user: current_user, namespace: :effective)
      = render_datatable(datatable)

  %p= link_to "Add a new #{etd(Effective::WorkExperienceProject)}", effective_work_experience.new_work_experience_project_path, class: 'btn btn-primary'

  %hr

%h4 #{EffectiveWorkExperience.summary_months}-Month #{work_experience_summary_label} Submissions
%p Every #{EffectiveWorkExperience.summary_months} months you are required to submit a #{work_experience_summary_label.downcase} to be reviewed.

.mb-2
  = collapse("Show #{ets(EffectiveWorkExperience.WorkExperienceSummary)}") do
    - datatable = EffectiveWorkExperienceSummariesDatatable.new(self, user: current_user)
    = render_datatable(datatable)

- # In progress
- work_experience_summary = current_user.work_experience_summaries.in_progress.first

- if work_experience_summary.present? && work_experience_summary.draft?
  %p
    Your submission is incomplete.

    %p
      Please
      = link_to("Continue #{work_experience_summary_label.downcase}", effective_work_experience.work_experience_summary_build_path(work_experience_summary, work_experience_summary.next_step), 'data-turbolinks' => false, 'data-turbo' => false, class: 'btn btn-primary')
      or you can
      = link_to("Abandon #{work_experience_summary_label.downcase}", effective_work_experience.work_experience_summary_path(work_experience_summary), 'data-confirm': "Really delete #{work_experience_summary}?", 'data-method': :delete, class: 'btn btn-danger')
      to start again.

- elsif EffectiveResources.authorized?(self, :new, EffectiveWorkExperience.WorkExperienceSummary)
  %p= link_to "Add a new #{etd(EffectiveWorkExperience.WorkExperienceSummary)}", effective_work_experience.new_work_experience_summary_path, class: 'btn btn-primary'
