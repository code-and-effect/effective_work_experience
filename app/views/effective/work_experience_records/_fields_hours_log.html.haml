= f.hide_if(:backdated, true) do
  .row
    .col-lg-4
      = f.date_field :month, hint: 'Please select the first day of the month that applies to these hours'

- if local_assigns[:namespace] == :admin
  = f.check_box :backdated, label: "Backdated #{et(f.object)}", hint: "Admin only. There can only be one backdated #{et(f.object)}. This allows admins to contribute hours to each category, which essentially reduces total required hours."

= f.text_area :description
= f.date_field :date
= f.number_text_field :total_hours
= f.select :work_experience_subcategory_id, f.object.work_experience_subcategories.group_by(&:work_experience_category), grouped: true, label: 'Subcategory'
