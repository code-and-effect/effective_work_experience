- f.object.approve_work_experience_summary = true if f.object.mentor_recommendation == f.object.recommendations.first
= f.check_box :approve_work_experience_summary, label: "Approve #{et(f.object)}"

= f.article_editor :mentor_comments, label: "#{work_experience_mentor_label} comments", hint: "These are private comments and are not displayed to the #{work_experience_intern_label.downcase}"
