- hint = EffectiveWorkExperience.show_reviews_to_intern ? "Your recommendation and comments will be shown to the #{work_experience_intern_label.downcase} after you complete this review." : "Your recommendation and comments will not be shown to the #{work_experience_intern_label.downcase}."
= f.radios :mentor_recommendation, work_experience_recommendation_collection, label: "#{work_experience_mentor_label} recommendation", required: true, hint: hint

= f.article_editor :mentor_comments, label: "#{work_experience_mentor_label} comments", hint: hint
