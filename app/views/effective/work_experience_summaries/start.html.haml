= render 'layout' do
  = render 'effective/work_experience_summaries/content', resource: resource

  = card do
    = effective_form_with(model: resource, url: wizard_path(step), method: :put) do |f|
      = f.hidden_field :id

      - if f.object.mentor.blank?
        %p No #{work_experience_mentor_label.downcase} has been assigned. Please contact the office to be assigned one.
      - else
        %p Your #{work_experience_mentor_label.downcase} for this #{etd(f.object.class)} is #{f.object.mentor}.
        %p Please contact the office if this is incorrect.

      = render('effective/work_experience_summaries/start_fields', f: f)

      = f.submit 'Save and Continue', left: true
