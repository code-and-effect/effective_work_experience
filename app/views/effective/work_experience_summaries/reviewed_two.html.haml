= render 'layout' do
  = render 'effective/work_experience_summaries/content', resource: resource
  - raise('expected a reviewed work experience summary') unless resource.has_completed_step?(:review_two)

  - if resource.reviewed_at.present?
    .alert.alert-info.mb-4
      This #{etd(resource.class)} was reviewed on #{resource.reviewed_at.strftime('%F')}

  - if resource.approved_at.present?
    .alert.alert-success.mb-4
      This #{etd(resource.class)} was approved on #{resource.approved_at.strftime('%F')}

  - if resource.declined_at.present?
    .alert.alert-warning.mb-4
      This #{etd(resource.class)} was declined on #{resource.declined_at.strftime('%F')}

  = render('effective/work_experience_summaries/work_experience_summary', work_experience_summary: resource)

  .mb-4
    = link_to "Return to Dashboard", return_to_dashboard_path, class: 'btn btn-lg btn-primary btn-block'
