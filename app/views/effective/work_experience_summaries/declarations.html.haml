= render 'layout' do
  = render 'effective/work_experience_summaries/content', resource: resource

  = card do
    = render_if_exists('effective/work_experience_summaries/declarations_requirements', work_experience_summary: resource)

    = effective_form_with(model: resource, url: wizard_path(step), method: :put) do |f|
      = f.hidden_field :id

      = render('effective/work_experience_summaries/declarations_fields', f: f)

      = f.submit 'Save and Continue', left: true
